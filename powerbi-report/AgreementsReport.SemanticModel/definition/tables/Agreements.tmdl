table Agreements
	lineageTag: 22689cfd-e43d-42de-a928-47361e04341b

	measure Agreements = COALESCE(COUNTROWS('Agreements'), 0)
		formatString: #,0
		lineageTag: 35a3bd80-9e54-4177-9520-83082b88f592

	measure 'Active Agreements' =
			CALCULATE(
			    COALESCE(COUNTROWS('Agreements'), 0),
			    VAR LastDayOfPeriod = MAX('Date'[Date])
			    RETURN
			    FILTER(
			        'Agreements',
			        NOT ( ISBLANK('Agreements'[EffectiveDate]) && ISBLANK('Agreements'[ExpirationDate]) )
			        && ( ISBLANK('Agreements'[EffectiveDate]) || 'Agreements'[EffectiveDate] <= LastDayOfPeriod )
			        && ( ISBLANK('Agreements'[ExpirationDate]) || 'Agreements'[ExpirationDate] > LastDayOfPeriod )
			    )
			)
		formatString: #,0
		lineageTag: cfdf08cd-0eab-48d4-8ed0-b13a69e93c54

	measure 'Agreements Expiring Next 90 Days' = COALESCE(SUM('Agreements'[IsExpiringIn90days]), 0)
		formatString: #,0
		lineageTag: 1a6bc89b-181b-4eff-aac5-96de7f4cb4f2

	measure 'Agreements Due for Renewal Next 90 Days' = COALESCE(SUM('Agreements'[IsRenewingIn90days]), 0)
		formatString: #,0
		lineageTag: c7fde25c-3d0a-4942-b6db-476389241513

	measure 'Termination Notice Deadlines' =
			COALESCE(
			    CALCULATE(
			        COUNTROWS('Agreements'),
			        FILTER(
			            'Agreements',
			            'Agreements'[TerminationNoticeDueDate] >= MIN('Date'[Date]) &&
			            'Agreements'[TerminationNoticeDueDate] <= MAX('Date'[Date])
			        )
			    ),
			0)
		formatString: #,0
		lineageTag: ea6da5e9-1464-44d7-a521-287f804ebb55

	measure 'All Expired Agreements' =
			VAR TodayDate = TODAY()
			RETURN
			COALESCE(
			    CALCULATE(
			        COUNTROWS('Agreements'),
			        FILTER(
			            'Agreements',
			            NOT ISBLANK('Agreements'[ExpirationDate]) &&
			            'Agreements'[ExpirationDate] < TodayDate
			        )
			    ),
			0)
		formatString: #,0
		lineageTag: 20687f09-dc3e-4fc4-9e5d-12e89b0c6332

	measure 'All Pending Renewal' =
			VAR TodayDate = TODAY()
			RETURN
			COALESCE(
			    CALCULATE(
			        COUNTROWS('Agreements'),
			        FILTER(
			            'Agreements',
			            NOT ISBLANK('Agreements'[RenewalNoticeDate])
			            && ( ISBLANK('Agreements'[ExpirationDate]) || 'Agreements'[ExpirationDate] > TodayDate )
			        )
			    ),
			0)
		formatString: #,0
		lineageTag: d0df789e-7b39-4ef8-830b-91cdd99f46a2

	measure 'All Active Agreements Without Renewals' =
			VAR TodayDate = TODAY()
			VAR TotalActiveAgreements =
			    CALCULATE(
			        COUNTROWS('Agreements'),
			        FILTER(
			            'Agreements',
			            NOT ( ISBLANK('Agreements'[EffectiveDate]) && ISBLANK('Agreements'[ExpirationDate]) )
			            && ( ISBLANK('Agreements'[EffectiveDate]) || 'Agreements'[EffectiveDate] <= TodayDate )
			            && ( ISBLANK('Agreements'[ExpirationDate]) || 'Agreements'[ExpirationDate] >= TodayDate )
			        )
			    )
			VAR AgreementsPendingRenewal = [All Pending Renewal]
			RETURN
			COALESCE(TotalActiveAgreements - AgreementsPendingRenewal, 0)
		formatString: #,0
		lineageTag: 8a7fe27c-db83-496c-924d-8de8fc01f796

	measure 'Renewing Soon Count' = COALESCE(SUM('Agreements'[IsRenewingIn90days]), 0)
		formatString: #,0
		lineageTag: 6af16978-7fa8-4508-af2d-39979ec29bec

	measure 'Expiring Soon (Non-Renewing) Count' =
			VAR TodayDate = TODAY()
			VAR NinetyDaysOut = TodayDate + 90
			RETURN
			COALESCE(
			    CALCULATE(
			        COUNTROWS('Agreements'),
			        FILTER(
			            'Agreements',
			            'Agreements'[ExpirationDate] >= TodayDate &&
			            'Agreements'[ExpirationDate] <= NinetyDaysOut
			            && ISBLANK('Agreements'[RenewalNoticeDate])
			        )
			    ),
			0)
		formatString: #,0
		lineageTag: 8cd6ff39-6ddd-4eac-9e1e-e923fd776931

	measure 'Dynamic Status Count' =
			VAR SelectedStatus = SELECTEDVALUE('Agreement Status Breakdown'[Status])
			RETURN
			SWITCH(
			    SelectedStatus,
			    "Expired", [All Expired Agreements],
			    "Pending Renewal", [All Pending Renewal],
			    "Active (Non-Renewal)", [All Active Agreements Without Renewals],
			    BLANK()
			)
		formatString: #,0
		lineageTag: 021cb256-4765-4b02-b5c6-9ed5e1208a48

	measure ActiveAgreementsCount = COALESCE(SUM('Agreements'[IsActive]), 0)
		formatString: #,0
		lineageTag: 2f6530dc-fc31-49ce-83f6-1382d3922b6e

	measure AutoRenewalAgreementsCount = COALESCE(CALCULATE(COUNTROWS('Agreements'), 'Agreements'[IsAutoRenewal] = TRUE), 0)
		formatString: #,0
		lineageTag: daf30a5f-f7c6-4503-9933-925f2818fc34

	measure 'Total Contract Value' = COALESCE(SUM('Agreements'[TotalValue]), 0)
		formatString: \$#,0
		lineageTag: c8c42d79-04b3-4149-9f2f-c29e760c60c5

