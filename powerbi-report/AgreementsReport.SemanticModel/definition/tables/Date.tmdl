	column Month
		dataType: string
		lineageTag: fa605cf5-5fd7-49ed-9c23-81b25c934f4e
		sortByColumn: 'Month Sort'
		summarizeBy: none
		sourceColumn: Month

		annotation SummarizationSetBy = Automatic

	column 'Month Sort'
		dataType: int64
		formatString: 0
		lineageTag: fde34a21-b76e-4319-84e8-25a7717cca3a
		summarizeBy: none
		sourceColumn: Month Sort

		annotation SummarizationSetBy = Automatic

	partition Date = m
		mode: import
		source =
				let
				    StartDate = #date(2010, 1, 1),
				    EndDate = #date(Date.Year(Date.From(DateTime.LocalNow())) + 10, 12, 31),
				    Dates = List.Dates(StartDate, Number.From(EndDate - StartDate) + 1, #duration(1, 0, 0, 0)),
				    AsTable = Table.FromList(Dates, Splitter.SplitByNothing(), {"Date"}),
				    Typed = Table.TransformColumnTypes(AsTable, {{"Date", type date}}),
				    WithYear = Table.AddColumn(Typed, "Year", each Date.Year([Date]), Int64.Type),
				    WithMonthName = Table.AddColumn(WithYear, "Month Name", each Date.ToText([Date], "MMMM"), type text),
				    WithMonthNumber = Table.AddColumn(WithMonthName, "Month Number", each Date.Month([Date]), Int64.Type),
				    WithMonth = Table.AddColumn(WithMonthNumber, "Month", each Date.ToText([Date], "MMMM yyyy"), type text),
				    WithMonthSort = Table.AddColumn(WithMonth, "Month Sort", each Date.Year([Date]) * 100 + Date.Month([Date]), Int64.Type)
				in
				    WithMonthSort

	annotation PBI_ResultType = Table
