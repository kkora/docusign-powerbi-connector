table Envelopes
	lineageTag: e8a9d04f-2823-4ddd-988c-1e60f996f2bc

	measure 'Total Envelopes' = COALESCE(COUNTROWS(Envelopes), 0)
		formatString: #,0
		lineageTag: 870409aa-af67-47c5-b415-b0ec73fb32af

	measure 'Completed Envelopes' = COALESCE(CALCULATE(COUNTROWS(Envelopes), Envelopes[Status] = "completed"), 0)
		formatString: #,0
		lineageTag: 0feae085-acaa-451e-b16b-763063f5860f

	measure 'Voided Envelopes' = COALESCE(CALCULATE(COUNTROWS(Envelopes), Envelopes[Status] = "voided"), 0)
		formatString: #,0
		lineageTag: 101a8ee1-57d9-438d-8823-69e4eafe4349

	measure 'Declined Envelopes' = COALESCE(CALCULATE(COUNTROWS(Envelopes), Envelopes[Status] = "declined"), 0)
		formatString: #,0
		lineageTag: 9cf966cb-d95a-4c92-8284-f8f6ff42511b

