model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["Environment","AccountId","Agreements","Parties","CustomField","Date","Agreement Status Breakdown"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table Agreements
ref table Parties
ref table CustomField
ref table Date
ref table 'Agreement Status Breakdown'
