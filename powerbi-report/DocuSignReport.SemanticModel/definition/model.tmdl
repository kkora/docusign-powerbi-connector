model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["Envelopes","Recipients","Envelope Status","Envelope Custom Fields","Envelope Audit Events","Templates","Envelope Documents","Accounts"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table Envelopes
ref table Recipients
ref table 'Envelope Status'
ref table 'Envelope Custom Fields'
ref table 'Envelope Audit Events'
ref table Templates
ref table 'Envelope Documents'
ref table Accounts

